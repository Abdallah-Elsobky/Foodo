<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="iti.student.foodo.features.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/navigateToRegisterFromLogin"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/navigateToForgetPasswordFromLogin"
            app:destination="@id/forgetPasswordFragment" />
        <action
            android:id="@+id/navigateToMainFromLogin"
            app:destination="@id/main_nav_graph" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="iti.student.foodo.features.auth.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" />
    <fragment
        android:id="@+id/forgetPasswordFragment"
        android:name="iti.student.foodo.features.auth.ForgetPasswordFragment"
        android:label="fragment_forget_password"
        tools:layout="@layout/fragment_forget_password" />
    <include app:graph="@navigation/main_nav_graph" />
</navigation>