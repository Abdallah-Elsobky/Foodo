<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TitleTextView">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>

    </style>

    <style name="hintTextView">
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="CustomChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/orange</item>
        <item name="android:backgroundTint">@color/dark_blur</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="hintTextColor">@color/orange</item>
        <item name="boxStrokeColor">@color/orange</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>

        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingVertical">16dp</item>

        <item name="backgroundTint">@color/orange</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:textColor">@color/orange</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>

        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <style name="CustomLoading">
        <item name="lottie_autoPlay">true</item>
        <item name="lottie_colorFilter">@color/orange</item>
        <item name="lottie_loop">true</item>
        <item name="lottie_rawRes">@raw/loading</item>
    </style>


</resources>